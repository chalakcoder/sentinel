# ================================================================
# Confluent Cloud
# ================================================================
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
CONFLUENT_API_KEY=xxxxx
CONFLUENT_API_SECRET=xxxxx
CONFLUENT_SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-2.aws.confluent.cloud
CONFLUENT_SCHEMA_REGISTRY_API_KEY=xxxxx
CONFLUENT_SCHEMA_REGISTRY_API_SECRET=xxxxx
CONFLUENT_ENVIRONMENT_ID=env-xxxxx
CONFLUENT_CLUSTER_ID=lkc-xxxxx

# ================================================================
# MongoDB Atlas (platinum sponsor — use Atlas, not local, for demo)
# ================================================================
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DATABASE=sentinel
MONGODB_FRAUD_ALERTS_COLLECTION=fraud_alerts
MONGODB_AGENT_DECISIONS_COLLECTION=agent_decisions
MONGODB_FRAUD_CASES_COLLECTION=fraud_cases

# ================================================================
# IBM WatsonX (judges will notice — mandatory integration)
# Get credentials from: cloud.ibm.com → watsonx.ai
# ================================================================
WATSONX_API_KEY=xxxxx
WATSONX_PROJECT_ID=xxxxx
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ================================================================
# ChromaDB (vector store for similar fraud case lookup)
# ================================================================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=fraud_cases

# ================================================================
# Application tuning
# ================================================================
FRAUD_RISK_THRESHOLD=0.7
TRANSACTIONS_PER_SECOND=100
FRAUD_INJECTION_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
