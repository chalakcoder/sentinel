{
  "name": "mongodb-sink-fraud-alerts",
  "connector.class": "MongoDbAtlasSink",
  "kafka.auth.mode": "KAFKA_API_KEY",
  "kafka.api.key": "${file:/opt/docker/secrets/connect-secrets.properties:CONFLUENT_API_KEY}",
  "kafka.api.secret": "${file:/opt/docker/secrets/connect-secrets.properties:CONFLUENT_API_SECRET}",
  "topics": "fraud-alerts",
  "connection.host": "${file:/opt/docker/secrets/connect-secrets.properties:MONGODB_CLUSTER_HOST}",
  "connection.user": "${file:/opt/docker/secrets/connect-secrets.properties:MONGODB_USER}",
  "connection.password": "${file:/opt/docker/secrets/connect-secrets.properties:MONGODB_PASSWORD}",
  "database": "sentinel",
  "collection": "fraud_alerts",
  "max.num.retries": 3,
  "retries.defer.timeout": 5000,
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "${file:/opt/docker/secrets/connect-secrets.properties:CONFLUENT_SCHEMA_REGISTRY_URL}",
  "value.converter.basic.auth.credentials.source": "USER_INFO",
  "value.converter.basic.auth.user.info": "${file:/opt/docker/secrets/connect-secrets.properties:CONFLUENT_SCHEMA_REGISTRY_API_KEY}:${file:/opt/docker/secrets/connect-secrets.properties:CONFLUENT_SCHEMA_REGISTRY_API_SECRET}",
  "document.id.strategy": "com.mongodb.kafka.connect.sink.processor.id.strategy.ProvidedInKeyStrategy",
  "writemodel.strategy": "com.mongodb.kafka.connect.sink.writemodel.strategy.ReplaceOneDefaultStrategy",
  "document.id.strategy.overwrite.existing": "true",
  "transforms": "addKafkaMetadata",
  "transforms.addKafkaMetadata.type": "org.apache.kafka.connect.transforms.InsertField$Value",
  "transforms.addKafkaMetadata.timestamp.field": "kafka_ingested_at"
}
