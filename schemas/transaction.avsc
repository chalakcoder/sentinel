{
  "type": "record",
  "name": "Transaction",
  "namespace": "com.sentinel.fraud",
  "doc": "Raw UPI/card transaction event from Indian payments network",
  "fields": [
    {"name": "transaction_id",    "type": "string",  "doc": "UUID v4 unique identifier"},
    {"name": "user_id",           "type": "string",  "doc": "Customer identifier",
     "confluent.field.meta": {"tags": ["PII", "GDPR"]}},
    {"name": "card_number",       "type": "string",  "doc": "Masked card/UPI VPA",
     "confluent.field.meta": {"tags": ["PII", "PCI_DSS"]}},
    {"name": "amount",            "type": "double",  "doc": "Transaction amount in INR"},
    {"name": "currency",          "type": "string",  "default": "INR"},
    {"name": "merchant_id",       "type": "string"},
    {"name": "merchant_name",     "type": "string"},
    {"name": "merchant_category", "type": {
      "type": "enum",
      "name": "MerchantCategory",
      "symbols": ["GROCERY","FUEL","RESTAURANT","ECOMMERCE","UTILITY","ATM",
                  "TRAVEL","ENTERTAINMENT","MEDICAL","EDUCATION","RECHARGE","OTHER"]
    }},
    {"name": "transaction_type",  "type": {
      "type": "enum",
      "name": "TransactionType",
      "symbols": ["UPI", "CREDIT_CARD", "DEBIT_CARD", "NEFT", "IMPS"]
    }},
    {"name": "latitude",          "type": "double",  "doc": "Transaction location latitude",
     "confluent.field.meta": {"tags": ["PII"]}},
    {"name": "longitude",         "type": "double",  "doc": "Transaction location longitude",
     "confluent.field.meta": {"tags": ["PII"]}},
    {"name": "city",              "type": "string"},
    {"name": "device_id",         "type": ["null", "string"], "default": null},
    {"name": "ip_address",        "type": ["null", "string"], "default": null,
     "confluent.field.meta": {"tags": ["PII"]}},
    {"name": "timestamp",         "type": {"type": "long", "logicalType": "timestamp-millis"},
     "doc": "Event time in epoch milliseconds — used for Flink watermarks"},
    {"name": "is_international",  "type": "boolean", "default": false}
  ]
}
