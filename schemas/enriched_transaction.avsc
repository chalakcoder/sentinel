{
  "type": "record",
  "name": "EnrichedTransaction",
  "namespace": "com.sentinel.fraud",
  "doc": "Transaction enriched by Flink with window features and customer profile data",
  "fields": [
    {"name": "transaction_id",     "type": "string"},
    {"name": "user_id",            "type": "string",
     "confluent.field.meta": {"tags": ["PII"]}},
    {"name": "card_number",        "type": "string",
     "confluent.field.meta": {"tags": ["PII", "PCI_DSS"]}},
    {"name": "amount",             "type": "double"},
    {"name": "merchant_category",  "type": "string"},
    {"name": "city",               "type": "string"},
    {"name": "latitude",           "type": "double",
     "confluent.field.meta": {"tags": ["PII"]}},
    {"name": "longitude",          "type": "double",
     "confluent.field.meta": {"tags": ["PII"]}},
    {"name": "timestamp",          "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "txn_count_5min",     "type": "int",    "doc": "Card transaction count in rolling 5-minute window"},
    {"name": "txn_sum_5min",       "type": "double", "doc": "Card spend sum in rolling 5-minute window"},
    {"name": "txn_avg_5min",       "type": "double", "doc": "Card spend average in rolling 5-minute window"},
    {"name": "txn_count_1hour",    "type": "int",    "doc": "Card transaction count in rolling 1-hour window"},
    {"name": "txn_sum_1hour",      "type": "double", "doc": "Card spend sum in rolling 1-hour window"},
    {"name": "geo_deviation_km",   "type": "double", "doc": "Haversine distance from customer home in km"},
    {"name": "amount_ratio",       "type": "double", "doc": "Ratio of this amount to customer 30-day average"},
    {"name": "merchant_cat_risk",  "type": "double", "doc": "Static merchant category risk score 0.0-1.0"},
    {"name": "home_city",          "type": "string"},
    {"name": "customer_risk_tier", "type": "string"},
    {"name": "account_age_days",   "type": "int"},
    {"name": "velocity_flag",      "type": "boolean", "doc": "True if txn_count_5min > 5"},
    {"name": "geo_jump_flag",      "type": "boolean", "doc": "True if transaction > 500km from home city"}
  ]
}
