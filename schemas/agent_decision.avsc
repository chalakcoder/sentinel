{
  "type": "record",
  "name": "AgentDecision",
  "namespace": "com.sentinel.fraud",
  "doc": "LangGraph + IBM WatsonX agent decision on a fraud alert",
  "fields": [
    {"name": "decision_id",      "type": "string"},
    {"name": "alert_id",         "type": "string"},
    {"name": "transaction_id",   "type": "string"},
    {"name": "user_id",          "type": "string",
     "confluent.field.meta": {"tags": ["PII"]}},
    {"name": "action",           "type": {
      "type": "enum",
      "name": "AgentAction",
      "symbols": ["BLOCK", "FLAG", "APPROVE", "ESCALATE"]
    }},
    {"name": "confidence",       "type": "double",  "doc": "Agent confidence in decision 0.0-1.0"},
    {"name": "reasoning",        "type": "string",  "doc": "Plain-language explanation from WatsonX LLM"},
    {"name": "similar_cases",    "type": {"type": "array", "items": "string"},
     "doc": "IDs of similar historical fraud cases from vector search"},
    {"name": "agent_steps",      "type": {"type": "array", "items": "string"},
     "doc": "LangGraph node execution trace for auditability"},
    {"name": "latency_ms",       "type": "long",    "doc": "End-to-end agent processing time"},
    {"name": "llm_model",        "type": "string",  "doc": "WatsonX model ID used"},
    {"name": "decided_at",       "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
